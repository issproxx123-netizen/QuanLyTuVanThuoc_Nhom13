@model BaoCaoViewModel
@{ ViewData["Title"] = "Báo cáo thống kê"; }
<section class="page-header no-print"><div><p class="eyebrow">PHÂN TÍCH DỮ LIỆU</p><h2>Báo cáo và thống kê</h2><p>Số liệu được tổng hợp trực tiếp từ cơ sở dữ liệu</p></div><div class="header-actions"><a class="btn secondary" asp-action="ExportCsv">↓ Xuất CSV kho thuốc</a><button onclick="window.print()" class="btn primary">🖨 In báo cáo</button></div></section>
<section class="stat-grid"><div class="stat-card"><span>Bệnh nhân</span><strong>@Model.TongBenhNhan</strong><small>Hồ sơ</small></div><div class="stat-card"><span>Thuốc</span><strong>@Model.TongThuoc</strong><small>Đang hoạt động</small></div><div class="stat-card"><span>Phiếu tư vấn</span><strong>@Model.TongDon</strong><small>Đã lập</small></div><div class="stat-card danger"><span>Cảnh báo</span><strong>@Model.TongCanhBao</strong><small>Đã ghi nhận</small></div></section>
<section class="content-grid"><div class="card wide"><div class="card-title"><div><h3>Lượt tư vấn 7 ngày gần nhất</h3><p class="muted">Dữ liệu thật theo ngày</p></div><span class="value-chip">@Model.LuotTuVanTheoNgay.Sum(x => x.Value) lượt</span></div><div class="bar-chart dynamic large">@foreach (var x in Model.LuotTuVanTheoNgay) { <div class="bar-column"><span class="bar-value">@x.Value</span><div class="bar" style="height:@x.HeightPercent%"></div><small>@x.Label</small></div> }</div></div>
<div class="card"><h3>Tóm tắt vận hành</h3><div class="detail-list"><div><span>Tồn kho thấp</span><strong>@Model.ThuocTonKhoThap thuốc</strong></div><div><span>Sắp hết hạn</span><strong>@Model.ThuocSapHetHan thuốc</strong></div><div><span>Phiếu nhập kho</span><strong>@Model.TongPhieuNhap phiếu</strong></div><div><span>Giá trị tồn kho</span><strong>@Model.GiaTriTonKho.ToString("N0") ₫</strong></div></div></div></section>
<section class="content-grid"><div class="card"><div class="card-title"><h3>Thuốc cần chú ý</h3><a asp-controller="Thuoc" asp-action="CanhBao">Mở danh sách →</a></div><div class="medicine-warning">@foreach (var x in Model.ThuocCanChuY) { <div><strong>@x.TenThuoc @x.HamLuong</strong><span>@x.LoaiThuoc?.TenLoaiThuoc · Tồn @x.SoLuongTon · HSD @x.HanSuDung?.ToString("dd/MM/yyyy")</span></div> } @if (!Model.ThuocCanChuY.Any()) { <div class="empty-mini">Không có thuốc cần chú ý.</div> }</div></div>
<div class="card wide"><h3>Phiếu tư vấn gần đây</h3><div class="table-wrap"><table class="table"><thead><tr><th>Mã</th><th>Bệnh nhân</th><th>Triệu chứng</th><th>Ngày</th></tr></thead><tbody>@foreach (var x in Model.DonGanDay) { <tr><td>TV@x.MaDonTuVan.ToString("000")</td><td>@x.BenhNhan?.HoTen</td><td>@x.TrieuChung</td><td>@x.NgayTuVan.ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table></div></div></section>
<section class="card"><h3>Nhập kho gần đây</h3><div class="table-wrap"><table class="table"><thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Người nhập</th><th>Số mặt hàng</th><th>Ngày nhập</th></tr></thead><tbody>@foreach (var x in Model.PhieuNhapGanDay) { <tr><td>NK@x.MaPhieuNhap.ToString("000")</td><td>@x.NhaCungCap</td><td>@x.NguoiDung?.HoTen</td><td>@x.ChiTietPhieuNhaps.Count</td><td>@x.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table></div></section>
