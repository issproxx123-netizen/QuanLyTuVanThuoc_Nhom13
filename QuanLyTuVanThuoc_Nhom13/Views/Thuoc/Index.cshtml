@model IEnumerable<Thuoc>
@{ ViewData["Title"] = "Kho dược phẩm"; }
<section class="page-header"><div><p class="eyebrow">QUẢN LÝ DƯỢC</p><h2>Kho dược phẩm</h2><p>Theo dõi danh mục, tồn kho, hạn dùng và trạng thái thuốc</p></div><div class="header-actions"><a asp-action="CanhBao" class="btn secondary">⚠ Cảnh báo kho</a>@if (User.IsInRole("Admin") || User.IsInRole("Nhân viên kho")) { <a asp-controller="PhieuNhapKho" asp-action="Create" class="btn secondary">📦 Nhập kho</a><a asp-action="Create" class="btn primary">＋ Thêm thuốc</a> }</div></section>
<section class="stat-grid small"><div class="stat-card"><span>Thuốc hiển thị</span><strong>@Model.Count()</strong></div><div class="stat-card danger"><span>Tồn kho thấp</span><strong>@Model.Count(x => x.TrangThai && x.SoLuongTon <= 50)</strong></div><div class="stat-card danger"><span>Sắp hết hạn</span><strong>@Model.Count(x => x.TrangThai && x.HanSuDung != null && x.HanSuDung <= DateTime.Today.AddDays(90))</strong></div></section>
<div class="card"><form method="get" class="toolbar"><input name="search" value="@ViewBag.Search" placeholder="Tìm tên thuốc, hàm lượng, công dụng..." /><select name="maLoaiThuoc" asp-items="ViewBag.LoaiThuocOptions"><option value="">Tất cả loại thuốc</option></select><label class="check-line compact"><input type="checkbox" name="showInactive" value="true" checked="@(ViewBag.ShowInactive == true ? "checked" : null)" /><span>Hiện thuốc ngừng dùng</span></label><button class="btn secondary">Lọc</button><a class="btn ghost" asp-action="Index">Đặt lại</a></form><div class="table-wrap"><table class="table"><thead><tr><th>Tên thuốc</th><th>Loại</th><th>Hàm lượng</th><th>Tồn kho</th><th>Hạn sử dụng</th><th>Giá bán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var x in Model) { var expiryDanger = x.HanSuDung.HasValue && x.HanSuDung <= DateTime.Today.AddDays(90); <tr class="@(!x.TrangThai ? "inactive-row" : "")"><td><strong>@x.TenThuoc</strong><br /><span class="muted">@x.DonViTinh</span></td><td>@x.LoaiThuoc?.TenLoaiThuoc</td><td>@x.HamLuong</td><td><span class="badge @(x.SoLuongTon <= 50 ? "danger" : "success")">@x.SoLuongTon @x.DonViTinh</span></td><td><span class="@(expiryDanger ? "danger-text" : "")">@x.HanSuDung?.ToString("dd/MM/yyyy")</span></td><td>@x.GiaBan.ToString("N0") ₫</td><td><span class="badge @(x.TrangThai ? "success" : "danger")">@(x.TrangThai ? "Hoạt động" : "Ngừng dùng")</span></td><td><div class="actions"><a asp-action="Details" asp-route-id="@x.MaThuoc">Xem</a>@if (User.IsInRole("Admin") || User.IsInRole("Nhân viên kho")) { <a asp-action="Edit" asp-route-id="@x.MaThuoc">Sửa</a><form asp-action="Toggle" asp-route-id="@x.MaThuoc" method="post"><button class="link-button @(x.TrangThai ? "danger-text" : "")">@(x.TrangThai ? "Ngừng" : "Kích hoạt")</button></form> }</div></td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="empty-cell">Không tìm thấy thuốc phù hợp.</td></tr> }
</tbody></table></div></div>
