@model IEnumerable<CanhBao>
@{ ViewData["Title"] = "Cảnh báo hệ thống"; }
<section class="page-header"><div><p class="eyebrow">AN TOÀN DƯỢC</p><h2>Cảnh báo hệ thống</h2><p>Theo dõi dị ứng, tồn kho thấp và hạn sử dụng</p></div></section>
<div class="card"><form method="get" class="toolbar"><select name="type"><option value="">Tất cả loại cảnh báo</option><option selected="@(ViewBag.Type == "Dị ứng thuốc" ? "selected" : null)">Dị ứng thuốc</option><option selected="@(ViewBag.Type == "Tồn kho thấp" ? "selected" : null)">Tồn kho thấp</option><option selected="@(ViewBag.Type == "Sắp hết hạn" ? "selected" : null)">Sắp hết hạn</option></select><select name="severity"><option value="">Tất cả mức độ</option><option selected="@(ViewBag.Severity == "Cao" ? "selected" : null)">Cao</option><option selected="@(ViewBag.Severity == "Trung bình" ? "selected" : null)">Trung bình</option></select><button class="btn secondary">Lọc</button><a class="btn ghost" asp-action="Index">Đặt lại</a></form><div class="alert-list expanded">
@foreach (var x in Model) { <div class="alert-item @(x.MucDo == "Cao" ? "high" : "medium")"><div class="alert-symbol">@(x.MucDo == "Cao" ? "!" : "i")</div><div class="alert-content"><div class="alert-head"><strong>@x.LoaiCanhBao</strong><span class="badge @(x.MucDo == "Cao" ? "danger" : "warning")">@x.MucDo</span></div><span>@x.NoiDung</span><small>@x.NgayTao.ToString("dd/MM/yyyy HH:mm") · @(x.BenhNhan?.HoTen ?? "Kho thuốc") @(x.Thuoc != null ? "· " + x.Thuoc.TenThuoc : "")</small></div></div> }
@if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">✓</div><h3>Không có cảnh báo phù hợp</h3><p>Kho thuốc và dữ liệu bệnh nhân đang ổn định.</p></div> }
</div></div>
