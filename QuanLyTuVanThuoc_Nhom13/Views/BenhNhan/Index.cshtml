@model IEnumerable<BenhNhan>
@{ ViewData["Title"] = "Quản lý bệnh nhân"; }
<section class="page-header"><div><p class="eyebrow">HỒ SƠ BỆNH NHÂN</p><h2>Quản lý bệnh nhân</h2><p>Tiếp nhận, tìm kiếm và theo dõi lịch sử tư vấn</p></div>@if (User.IsInRole("Admin") || User.IsInRole("Bác sĩ / Nhân viên tư vấn")) { <a asp-action="Create" class="btn primary">＋ Thêm bệnh nhân</a> }</section>
<div class="card"><form method="get" class="toolbar"><input name="search" value="@ViewBag.Search" placeholder="Tìm tên, số điện thoại hoặc dị ứng..." /><button class="btn secondary">Tìm kiếm</button><a asp-action="Index" class="btn ghost">Đặt lại</a></form><div class="table-wrap"><table class="table"><thead><tr><th>Mã</th><th>Họ tên</th><th>Giới tính</th><th>SĐT</th><th>Tiền sử bệnh</th><th>Dị ứng</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var x in Model) { var hasAllergy = !string.IsNullOrWhiteSpace(x.DiUng) && !x.DiUng.Equals("Không có", StringComparison.OrdinalIgnoreCase); <tr><td><span class="code-pill">@($"BN{x.MaBenhNhan:000}")</span></td><td><strong>@x.HoTen</strong></td><td>@x.GioiTinh</td><td>@x.SoDienThoai</td><td>@x.TienSuBenh</td><td><span class="badge @(hasAllergy ? "danger" : "success")">@(string.IsNullOrWhiteSpace(x.DiUng) ? "Chưa khai báo" : x.DiUng)</span></td><td>@x.NgayTao.ToString("dd/MM/yyyy")</td><td><div class="actions"><a asp-action="Details" asp-route-id="@x.MaBenhNhan">Xem</a>@if (User.IsInRole("Admin") || User.IsInRole("Bác sĩ / Nhân viên tư vấn")) { <a asp-action="Edit" asp-route-id="@x.MaBenhNhan">Sửa</a> } @if (User.IsInRole("Admin")) { <a class="danger-text" asp-action="Delete" asp-route-id="@x.MaBenhNhan">Xóa</a> }</div></td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="empty-cell">Không tìm thấy bệnh nhân.</td></tr> }
</tbody></table></div></div>
