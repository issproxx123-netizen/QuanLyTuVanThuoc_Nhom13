@model LoaiThuoc
@{ ViewData["Title"] = "Thêm loại thuốc"; }
<section class="page-header"><div><h2>Thêm loại thuốc</h2><p>Tạo danh mục phân loại mới</p></div><a asp-action="Index" class="btn ghost">← Quay lại</a></section>
<div class="card form-card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-group"><label asp-for="TenLoaiThuoc"></label><input asp-for="TenLoaiThuoc" /><span asp-validation-for="TenLoaiThuoc"></span></div><div class="form-group"><label asp-for="MoTa"></label><textarea asp-for="MoTa" rows="4"></textarea></div><div class="form-actions"><button class="btn primary">Lưu loại thuốc</button><a class="btn ghost" asp-action="Index">Hủy</a></div></form></div>
