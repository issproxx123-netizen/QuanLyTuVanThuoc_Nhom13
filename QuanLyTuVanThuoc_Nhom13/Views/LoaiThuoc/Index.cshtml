@model IEnumerable<LoaiThuoc>
@{ ViewData["Title"] = "Loại thuốc"; }
<section class="page-header"><div><p class="eyebrow">DANH MỤC DƯỢC</p><h2>Quản lý loại thuốc</h2><p>Phân nhóm thuốc phục vụ tìm kiếm và báo cáo</p></div>@if (User.IsInRole("Admin") || User.IsInRole("Nhân viên kho")) { <a class="btn primary" asp-action="Create">＋ Thêm loại thuốc</a> }</section>
<div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Mã</th><th>Tên loại</th><th>Mô tả</th><th>Số thuốc</th><th>Thao tác</th></tr></thead><tbody>@foreach (var x in Model) { <tr><td>LT@x.MaLoaiThuoc.ToString("00")</td><td><strong>@x.TenLoaiThuoc</strong></td><td>@x.MoTa</td><td><span class="badge success">@x.Thuocs.Count thuốc</span></td><td><div class="actions">@if (User.IsInRole("Admin") || User.IsInRole("Nhân viên kho")) { <a asp-action="Edit" asp-route-id="@x.MaLoaiThuoc">Sửa</a> } @if (User.IsInRole("Admin")) { <form asp-action="Delete" asp-route-id="@x.MaLoaiThuoc" method="post" onsubmit="return confirm('Xóa loại thuốc này?')"><button class="link-button danger-text">Xóa</button></form> }</div></td></tr> }</tbody></table></div></div>
