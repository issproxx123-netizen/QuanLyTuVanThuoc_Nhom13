@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="login-shell">
    <section class="login-hero">
        <div class="hero-logo">HC</div>
        <p class="eyebrow">HUTECH CLINIC · NHÓM 13</p>
        <h1>Hệ thống Quản lý<br />Tư vấn Thuốc</h1>
        <p>Quản lý bệnh nhân, kho dược, phiếu tư vấn, cảnh báo an toàn và báo cáo trên một nền tảng thống nhất.</p>
        <div class="feature-row"><span>✓ Kiểm tra tồn kho</span><span>✓ Cảnh báo dị ứng</span><span>✓ Phân quyền người dùng</span></div>
    </section>
    <section class="login-card">
        <div><p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p><h2>Đăng nhập hệ thống</h2><p class="muted">Sử dụng tài khoản demo bên dưới hoặc tài khoản do Admin cấp.</p></div>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-group"><label asp-for="TenDangNhap"></label><input asp-for="TenDangNhap" autofocus placeholder="admin" /><span asp-validation-for="TenDangNhap"></span></div>
            <div class="form-group"><label asp-for="MatKhau"></label><input asp-for="MatKhau" placeholder="••••••" /><span asp-validation-for="MatKhau"></span></div>
            <label class="check-line"><input asp-for="GhiNho" /> <span>Ghi nhớ đăng nhập</span></label>
            <button class="btn primary full" type="submit">Đăng nhập</button>
        </form>
        <div class="demo-accounts"><strong>Tài khoản demo — mật khẩu: 123456</strong><div><code>admin</code><code>bacsi</code><code>kho</code><code>quanly</code></div></div>
    </section>
</div>
