@model IEnumerable<DonTuVan>
@{ ViewData["Title"] = "Phiếu tư vấn"; }
<section class="page-header"><div><p class="eyebrow">NGHIỆP VỤ TƯ VẤN</p><h2>Danh sách phiếu tư vấn</h2><p>Tra cứu lịch sử tư vấn và kê thuốc cho bệnh nhân</p></div>@if (User.IsInRole("Admin") || User.IsInRole("Bác sĩ / Nhân viên tư vấn")) { <a asp-action="Create" class="btn primary">＋ Lập phiếu mới</a> }</section>
<div class="card"><form method="get" class="toolbar"><input name="search" value="@ViewBag.Search" placeholder="Tìm bệnh nhân, triệu chứng, chẩn đoán..." /><button class="btn secondary">Tìm kiếm</button><a class="btn ghost" asp-action="Index">Đặt lại</a></form><div class="table-wrap"><table class="table"><thead><tr><th>Mã phiếu</th><th>Bệnh nhân</th><th>Triệu chứng</th><th>Chẩn đoán</th><th>Người tư vấn</th><th>Ngày tư vấn</th><th></th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td><span class="code-pill">@($"TV{x.MaDonTuVan:000}")</span></td><td><strong>@x.BenhNhan?.HoTen</strong></td><td>@x.TrieuChung</td><td>@x.ChanDoan</td><td>@x.NguoiDung?.HoTen</td><td>@x.NgayTuVan.ToString("dd/MM/yyyy HH:mm")</td><td><a class="link" asp-action="Details" asp-route-id="@x.MaDonTuVan">Chi tiết</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="empty-cell">Không tìm thấy phiếu tư vấn.</td></tr> }
</tbody></table></div></div>
