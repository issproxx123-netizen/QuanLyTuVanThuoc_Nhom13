@model DonTuVan
@{
    ViewData["Title"] = "Chi tiết phiếu tư vấn";
}
<section class="page-header no-print">
    <div>
        <h2>Phiếu tư vấn thuốc @($"TV{Model.MaDonTuVan:000}")</h2>
        <p>Thông tin chi tiết phiếu tư vấn</p>
    </div>
    <div class="header-actions">
        <button onclick="window.print()" class="btn secondary">In phiếu</button>
        <a asp-action="Index" class="btn ghost">Quay lại</a>
    </div>
</section>

<div class="print-sheet">
    <div class="print-header">
        <h2>HUTECH CLINIC</h2>
        <h3>PHIẾU TƯ VẤN THUỐC</h3>
        <p>Mã phiếu: @($"TV{Model.MaDonTuVan:000}") - Ngày: @Model.NgayTuVan.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    <div class="content-grid">
        <div class="card">
            <h3>Thông tin bệnh nhân</h3>
            <div class="detail-list">
                <div><span>Họ tên</span><strong>@Model.BenhNhan?.HoTen</strong></div>
                <div><span>SĐT</span><strong>@Model.BenhNhan?.SoDienThoai</strong></div>
                <div><span>Tiền sử bệnh</span><strong>@Model.BenhNhan?.TienSuBenh</strong></div>
                <div><span>Dị ứng</span><strong>@Model.BenhNhan?.DiUng</strong></div>
            </div>
        </div>
        <div class="card">
            <h3>Kết quả tư vấn</h3>
            <div class="detail-list">
                <div><span>Người tư vấn</span><strong>@Model.NguoiDung?.HoTen</strong></div>
                <div><span>Triệu chứng</span><strong>@Model.TrieuChung</strong></div>
                <div><span>Chẩn đoán</span><strong>@Model.ChanDoan</strong></div>
                <div><span>Ghi chú</span><strong>@Model.GhiChu</strong></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h3>Danh sách thuốc</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Thuốc</th>
                    <th>Số lượng</th>
                    <th>Liều dùng</th>
                    <th>Cách dùng</th>
                    <th>Số ngày</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ChiTietDonTuVans)
                {
                    <tr>
                        <td><strong>@item.Thuoc?.TenThuoc @item.Thuoc?.HamLuong</strong></td>
                        <td>@item.SoLuong</td>
                        <td>@item.LieuDung</td>
                        <td>@item.CachDung</td>
                        <td>@item.SoNgayDung</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
