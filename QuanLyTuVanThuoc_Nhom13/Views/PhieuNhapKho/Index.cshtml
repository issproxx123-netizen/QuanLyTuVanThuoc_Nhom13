@model IEnumerable<PhieuNhapKho>
@{ ViewData["Title"] = "Nhập kho"; }
<section class="page-header"><div><p class="eyebrow">QUẢN LÝ NHẬP KHO</p><h2>Phiếu nhập kho</h2><p>Theo dõi nguồn cung, số lượng nhập và người thực hiện</p></div><a class="btn primary" asp-action="Create">＋ Tạo phiếu nhập</a></section>
<div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Mã phiếu</th><th>Nhà cung cấp</th><th>Người nhập</th><th>Mặt hàng</th><th>Tổng số lượng</th><th>Ngày nhập</th><th></th></tr></thead><tbody>@foreach (var x in Model) { <tr><td><span class="code-pill">@($"NK{x.MaPhieuNhap:000}")</span></td><td><strong>@x.NhaCungCap</strong></td><td>@x.NguoiDung?.HoTen</td><td>@x.ChiTietPhieuNhaps.Count</td><td>@x.ChiTietPhieuNhaps.Sum(c => c.SoLuongNhap)</td><td>@x.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td><td><a class="link" asp-action="Details" asp-route-id="@x.MaPhieuNhap">Chi tiết</a></td></tr> } @if (!Model.Any()) { <tr><td colspan="7" class="empty-cell">Chưa có phiếu nhập kho.</td></tr> }</tbody></table></div></div>
