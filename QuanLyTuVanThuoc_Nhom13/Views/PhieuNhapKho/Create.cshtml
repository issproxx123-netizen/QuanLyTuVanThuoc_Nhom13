@model PhieuNhapFormViewModel
@{ ViewData["Title"] = "Tạo phiếu nhập kho"; }
<section class="page-header"><div><p class="eyebrow">PHIẾU NHẬP MỚI</p><h2>Tạo phiếu nhập kho</h2><p>Số lượng tồn được cộng tự động sau khi lưu thành công</p></div><a class="btn ghost" asp-action="Index">← Quay lại</a></section>
<form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="content-grid consultation">
<div class="card"><h3>Thông tin phiếu nhập</h3><div class="form-group"><label asp-for="NhaCungCap"></label><input asp-for="NhaCungCap" placeholder="Tên công ty hoặc nhà cung cấp" /><span asp-validation-for="NhaCungCap"></span></div><div class="form-group"><label asp-for="GhiChu"></label><textarea asp-for="GhiChu" rows="5" placeholder="Số hóa đơn, ghi chú lô hàng..."></textarea><span asp-validation-for="GhiChu"></span></div><div class="safety-note">📦 Dữ liệu được lưu bằng transaction: nếu có lỗi, toàn bộ phiếu và tồn kho sẽ được hoàn tác.</div></div>
<div class="card"><h3>Danh sách thuốc nhập</h3>
@for (var i = 0; i < Model.ChiTietInputs.Count; i++)
{
<div class="medicine-row import-row">
<div class="row-number">@(i + 1)</div>
<div class="form-group span-2"><label>Thuốc</label><select asp-for="ChiTietInputs[i].MaThuoc" asp-items="Model.ThuocOptions"><option value="0">-- Chọn thuốc --</option></select><span asp-validation-for="ChiTietInputs[i].MaThuoc"></span></div>
<div class="form-group"><label>Số lượng</label><input asp-for="ChiTietInputs[i].SoLuongNhap" min="0" /><span asp-validation-for="ChiTietInputs[i].SoLuongNhap"></span></div>
<div class="form-group"><label>Đơn giá nhập</label><input asp-for="ChiTietInputs[i].DonGiaNhap" min="0" step="0.01" /><span asp-validation-for="ChiTietInputs[i].DonGiaNhap"></span></div>
<div class="form-group span-2"><label>Hạn sử dụng lô mới</label><input asp-for="ChiTietInputs[i].HanSuDung" type="date" /><span asp-validation-for="ChiTietInputs[i].HanSuDung"></span></div>
</div>
}
<div class="form-actions end"><button class="btn primary" type="submit">✓ Lưu và cộng tồn kho</button><a class="btn ghost" asp-action="Index">Hủy</a></div></div></div></form>
