@model PhieuNhapKho
@{ ViewData["Title"] = "Chi tiết phiếu nhập"; }
<section class="page-header no-print"><div><p class="eyebrow">PHIẾU NHẬP KHO</p><h2>@($"NK{Model.MaPhieuNhap:000}")</h2><p>@Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</p></div><div class="header-actions"><button onclick="window.print()" class="btn secondary">🖨 In phiếu</button><a class="btn ghost" asp-action="Index">← Danh sách</a></div></section>
<div class="print-sheet"><section class="content-grid"><div class="card"><h3>Thông tin chung</h3><div class="detail-list"><div><span>Nhà cung cấp</span><strong>@Model.NhaCungCap</strong></div><div><span>Người nhập</span><strong>@Model.NguoiDung?.HoTen</strong></div><div><span>Ngày nhập</span><strong>@Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</strong></div><div><span>Ghi chú</span><strong>@Model.GhiChu</strong></div></div></div><div class="card"><h3>Tổng hợp</h3><div class="detail-list"><div><span>Số mặt hàng</span><strong>@Model.ChiTietPhieuNhaps.Count</strong></div><div><span>Tổng số lượng</span><strong>@Model.ChiTietPhieuNhaps.Sum(x => x.SoLuongNhap)</strong></div><div><span>Tổng giá trị nhập</span><strong>@Model.ChiTietPhieuNhaps.Sum(x => (x.DonGiaNhap ?? 0) * x.SoLuongNhap).ToString("N0") ₫</strong></div></div></div></section><div class="card"><h3>Chi tiết lô hàng</h3><div class="table-wrap"><table class="table"><thead><tr><th>Thuốc</th><th>Số lượng</th><th>Đơn giá nhập</th><th>Thành tiền</th><th>Hạn sử dụng</th></tr></thead><tbody>@foreach (var x in Model.ChiTietPhieuNhaps) { <tr><td><strong>@x.Thuoc?.TenThuoc @x.Thuoc?.HamLuong</strong></td><td>@x.SoLuongNhap</td><td>@x.DonGiaNhap?.ToString("N0") ₫</td><td>@(((x.DonGiaNhap ?? 0) * x.SoLuongNhap).ToString("N0")) ₫</td><td>@x.HanSuDung?.ToString("dd/MM/yyyy")</td></tr> }</tbody></table></div></div></div>
