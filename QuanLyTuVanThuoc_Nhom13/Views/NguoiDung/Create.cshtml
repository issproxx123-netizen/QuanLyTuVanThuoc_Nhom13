@model UserFormViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<section class="page-header"><div><h2>Tạo tài khoản</h2><p>Cấp tài khoản và vai trò sử dụng hệ thống</p></div><a class="btn ghost" asp-action="Index">← Quay lại</a></section>
<div class="card form-card"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="form-group"><label asp-for="HoTen"></label><input asp-for="HoTen" /><span asp-validation-for="HoTen"></span></div><div class="form-group"><label asp-for="TenDangNhap"></label><input asp-for="TenDangNhap" /><span asp-validation-for="TenDangNhap"></span></div><div class="form-group"><label asp-for="MatKhau"></label><input asp-for="MatKhau" /><span asp-validation-for="MatKhau"></span></div><div class="form-group"><label asp-for="MaVaiTro"></label><select asp-for="MaVaiTro" asp-items="Model.VaiTroOptions"><option value="">-- Chọn vai trò --</option></select></div><div class="form-group"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div><div class="form-group"><label asp-for="SoDienThoai"></label><input asp-for="SoDienThoai" /></div></div><label class="check-line"><input asp-for="TrangThai" /> <span>Tài khoản đang hoạt động</span></label><div class="form-actions"><button class="btn primary">Tạo tài khoản</button><a class="btn ghost" asp-action="Index">Hủy</a></div></form></div>
