@model IEnumerable<NguoiDung>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<section class="page-header"><div><p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p><h2>Quản lý tài khoản</h2><p>Phân quyền và kiểm soát trạng thái người dùng</p></div><a class="btn primary" asp-action="Create">＋ Tạo tài khoản</a></section>
<div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Người dùng</th><th>Tên đăng nhập</th><th>Liên hệ</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var x in Model) { <tr><td><strong>@x.HoTen</strong></td><td><code>@x.TenDangNhap</code></td><td>@x.Email<br /><span class="muted">@x.SoDienThoai</span></td><td><span class="badge success">@x.VaiTro?.TenVaiTro</span></td><td><span class="badge @(x.TrangThai ? "success" : "danger")">@(x.TrangThai ? "Hoạt động" : "Đã khóa")</span></td><td><div class="actions"><a asp-action="Edit" asp-route-id="@x.MaNguoiDung">Sửa</a><form asp-action="Toggle" asp-route-id="@x.MaNguoiDung" method="post"><button class="link-button @(x.TrangThai ? "danger-text" : "")">@(x.TrangThai ? "Khóa" : "Mở khóa")</button></form></div></td></tr> }</tbody></table></div></div>
