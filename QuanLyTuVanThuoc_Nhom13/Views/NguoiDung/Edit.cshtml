@model UserFormViewModel
@{ ViewData["Title"] = "Cập nhật tài khoản"; }
<section class="page-header">
    <div>
        <h2>Cập nhật tài khoản</h2>
        <p>Để trống mật khẩu nếu không muốn thay đổi</p>
    </div>
    <a class="btn ghost" asp-action="Index">← Quay lại</a>
</section>
<div class="card form-card">
    @if (ViewBag.IsCurrentUser == true)
    {
        <div class="safety-note">🛡️ Tài khoản đang đăng nhập không thể tự khóa hoặc tự gỡ quyền Admin.</div>
    }
    <form asp-action="Edit" asp-route-id="@Model.MaNguoiDung" method="post">
        <input asp-for="MaNguoiDung" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="HoTen"></label>
                <input asp-for="HoTen" />
                <span asp-validation-for="HoTen"></span>
            </div>
            <div class="form-group">
                <label asp-for="TenDangNhap"></label>
                <input asp-for="TenDangNhap" />
                <span asp-validation-for="TenDangNhap"></span>
            </div>
            <div class="form-group">
                <label asp-for="MatKhau">Mật khẩu mới</label>
                <input asp-for="MatKhau" placeholder="Để trống nếu giữ nguyên" />
                <span asp-validation-for="MatKhau"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaVaiTro"></label>
                <select asp-for="MaVaiTro" asp-items="Model.VaiTroOptions"></select>
                <span asp-validation-for="MaVaiTro"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoDienThoai"></label>
                <input asp-for="SoDienThoai" />
                <span asp-validation-for="SoDienThoai"></span>
            </div>
        </div>
        <label class="check-line">
            <input asp-for="TrangThai" />
            <span>Tài khoản đang hoạt động</span>
        </label>
        <span asp-validation-for="TrangThai"></span>
        <div class="form-actions">
            <button class="btn primary" type="submit">Lưu thay đổi</button>
            <a class="btn ghost" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>
