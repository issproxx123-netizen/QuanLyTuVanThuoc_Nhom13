@model IEnumerable<QuanLyTuVanThuoc.Models.Thuoc>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 shadow-sm rounded-3">
        <h2 class="text-dark mb-0 font-weight-bold">📦 QUẢN LÝ KHO DƯỢC PHẨM</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow">+ NHẬP THUỐC MỚI</a>
    </div>
    <div class="table-responsive bg-white shadow-sm rounded-3 p-4">
        <table class="table table-hover align-middle">
            <thead class="table-light text-primary">
                <tr>
                    <th>Tên Thuốc</th>
                    <th>Hàm Lượng</th>
                    <th>Tồn Kho</th>
                    <th>Loại Thuốc</th>
                    <th>Hướng Dẫn</th>
                    <th class="text-center">Tác Vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.TenThuoc</td>
                        <td>@item.HamLuong</td>
                        <td><span class="badge bg-info p-2 px-3">@item.SoLuongTon viên</span></td>
                        <td><span class="text-secondary font-italic">@item.LoaiThuoc</span></td>
                        <td class="text-muted" style="max-width: 250px;">@item.HuongDan</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xoá</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>