@model IEnumerable<QuanLyTuVanThuoc.Models.DonThuoc>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 shadow-sm rounded-3">
        <h2 class="text-dark mb-0 font-weight-bold">⚕️ QUY TRÌNH TƯ VẤN THUỐC</h2>
        <a asp-action="Create" class="btn btn-primary px-4 shadow">+ TIẾP NHẬN BỆNH NHÂN</a>
    </div>
    <div class="table-responsive bg-white shadow-sm rounded-3 p-4">
        <table class="table table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Bệnh Nhân</th>
                    <th>Thời Gian Kê Đơn</th>
                    <th>Trạng Thái</th>
                    <th class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.TenBenhNhan</td>
                        <td>@item.NgayKe.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.DaTuVan)
                            {
                                <span class="badge bg-success px-3">✔ Đã Hoàn Tất</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark px-3">⌛ Đang Chờ</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3">Hồ Sơ Chi Tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Hủy</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>